{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalPassThroughEnv": ["NEXT_TELEMETRY_DISABLED"],
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "//#depcruise": {
      "cache": false
    },
    "lint": {
      "dependsOn": ["transit", "//#depcruise"]
    },
    "typecheck": {
      "dependsOn": ["transit"]
    },
    "test": {
      "dependsOn": ["transit", "//#depcruise"]
    },
    "build": {
      "dependsOn": ["transit"],
      "outputs": [".next/**", "!.next/cache/**"]
    }
  }
}
