{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "//#depcruise": {
      "cache": false
    },
    "lint": {
      "dependsOn": ["transit", "//#depcruise"]
    },
    "typecheck": {
      "dependsOn": ["transit"]
    },
    "test": {
      "dependsOn": ["transit", "//#depcruise"]
    }
  }
}
