{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalPassThroughEnv": ["NEXT_TELEMETRY_DISABLED"],
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "//#depcruise": {
      "cache": false
    },
    "lint": {
      "dependsOn": ["transit", "//#depcruise"]
    },
    "typecheck": {
      "dependsOn": ["transit"]
    },
    "test": {
      "dependsOn": ["transit", "//#depcruise"]
    },
    "@docs-rag-lab/ts-docs#test": {
      "dependsOn": ["transit", "//#depcruise"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/*/package.json",
        "$TURBO_ROOT$/apps/*/app/globals.css",
        "$TURBO_ROOT$/apps/*/app/layout.tsx"
      ]
    },
    "build": {
      "dependsOn": ["transit"],
      "outputs": [".next/**", "!.next/cache/**"]
    }
  }
}
